[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UefiDashboard
  FILE_GUID                      = 18D17609-0798-4905-8392-E04B9E054F0D  
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain


[Sources]
  UefiDashboard.c
  UefiBasicInfo.c
  UefiBootOptions.c
  UefiTime.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  LvglPkg/LvglPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiLib
  MemoryAllocationLib
  BaseMemoryLib
  DebugLib
  PrintLib
  UefiBootManagerLib
  LvglLib

[Protocols]
  gEdkiiPlatformLogoProtocolGuid
  gEfiSmbiosProtocolGuid

[BuildOptions]
  #
  # Third-party LVGL code: keep upstream sources as-is and demote the
  # warning classes the EDK2 toolchain turns into errors.
  #
  GCC:*_*_*_CC_FLAGS = -Wno-error=char-subscripts -Wno-error=unused-but-set-variable -Wno-error=unused-variable -Wno-error=unused-function -Wno-error=discarded-qualifiers
