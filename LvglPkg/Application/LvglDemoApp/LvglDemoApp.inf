[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LvglDemoApp
  #
  # Was 18D17609-0798-4905-8392-E04B9E054F0D, which collided with
  # UefiDashboard.inf (upstream copy/paste bug); two modules with the same
  # FILE_GUID cannot coexist in one firmware volume.
  #
  FILE_GUID                      = 7A3E9D15-2B64-4F80-A1C7-5D38E2946B0F
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain


[Sources]
  LvglDemoApp.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  LvglPkg/LvglPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  MemoryAllocationLib
  BaseMemoryLib
  DebugLib
  LvglLib

[Protocols]
  gEdkiiPlatformLogoProtocolGuid

[BuildOptions]
  #
  # Third-party LVGL code: keep upstream sources as-is and demote the
  # warning classes the EDK2 toolchain turns into errors.
  #
  GCC:*_*_*_CC_FLAGS = -Wno-error=char-subscripts -Wno-error=unused-but-set-variable -Wno-error=unused-variable -Wno-error=unused-function -Wno-error=discarded-qualifiers -I$(WORKSPACE)/LvglPkg/Library/LvglLib
